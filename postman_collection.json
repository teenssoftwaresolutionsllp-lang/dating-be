{
  "info": {
    "name": "Dating App - Screen 1, 2 & 3 Authentication APIs",
    "description": "Postman Collection for Dating App: Language Selection -> Mobile Number -> OTP Verification Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Screen 1: Language Selection",
      "item": [
        {
          "name": "1. Get Supported Display Languages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/languages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "languages"]
            }
          }
        },
        {
          "name": "2. Update User Language (Authenticated)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"language\": \"te\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/language",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "language"]
            }
          }
        }
      ]
    },
    {
      "name": "Screen 2: Mobile Number & Login",
      "item": [
        {
          "name": "1. Send Mobile OTP (Login button)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"countryCode\": \"+91\",\n  \"phone\": \"9876543210\",\n  \"preferredLanguage\": \"te\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "send-otp"]
            }
          }
        },
        {
          "name": "2. Google Social Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerUserId\": \"google_user_12345\",\n  \"preferredLanguage\": \"te\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "google"]
            }
          }
        }
      ]
    },
    {
      "name": "Screen 3: OTP Verification",
      "item": [
        {
          "name": "1. Verify OTP (Verify button)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.tokens) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.tokens.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.data.tokens.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"countryCode\": \"+91\",\n  \"phone\": \"9876543210\",\n  \"otp\": \"1234\",\n  \"preferredLanguage\": \"te\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "verify-otp"]
            }
          }
        }
      ]
    },
    {
      "name": "Session & Profile",
      "item": [
        {
          "name": "Get Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh-token"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          }
        }
      ]
    }
  ]
}
