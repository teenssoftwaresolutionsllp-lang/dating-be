{
  "info": {
    "name": "Dating App - Matches, Discovery & Messaging APIs",
    "description": "Postman Collection for Dating App APIs, including discovery, messaging, and authenticated account lifecycle flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "targetUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "matchId",
      "value": "",
      "type": "string"
    },
    {
      "key": "messageId",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "deletionOtp",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & Status",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        },
        {
          "name": "Root Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          }
        }
      ]
    },
    {
      "name": "2. Discovery Feed (Explore / People Tab)",
      "item": [
        {
          "name": "Get Discovery Feed (Candidate Cards + Trust Score %)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.length > 0) {",
                  "    pm.collectionVariables.set('targetUserId', jsonData.data[0].userId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/matches/feed?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "matches", "feed"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Swipe Engine",
      "item": [
        {
          "name": "Swipe Like (❤️ Pink Heart)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetUserId\": \"{{targetUserId}}\",\n  \"direction\": \"like\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/matches/swipe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "matches", "swipe"]
            }
          }
        },
        {
          "name": "Swipe Pass (❌ Red Cross)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetUserId\": \"{{targetUserId}}\",\n  \"direction\": \"dislike\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/matches/swipe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "matches", "swipe"]
            }
          }
        },
        {
          "name": "Swipe Super Like (💬 Blue Chat Button)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetUserId\": \"{{targetUserId}}\",\n  \"direction\": \"superlike\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/matches/swipe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "matches", "swipe"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Matches Tab & Voluntary Chat",
      "item": [
        {
          "name": "Get Mutual Matches",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.length > 0) {",
                  "    pm.collectionVariables.set('matchId', jsonData.data[0].matchId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/matches?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "matches"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Start Chat Voluntarily with Match",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/matches/{{matchId}}/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "matches", "{{matchId}}", "chat"]
            }
          }
        },
        {
          "name": "Unmatch User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/matches/{{matchId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "matches", "{{matchId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Likes Tab (Who Liked Me)",
      "item": [
        {
          "name": "Get Likes Received",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/matches/likes?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "matches", "likes"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Safety & Moderation",
      "item": [
        {
          "name": "Block User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetUserId\": \"{{targetUserId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/matches/block",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "matches", "block"]
            }
          }
        },
        {
          "name": "Report User (Report & Block Profile)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetUserId\": \"{{targetUserId}}\",\n  \"reason\": \"fake_profile\",\n  \"description\": \"Suspicious profile behavior\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/matches/report",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "matches", "report"]
            }
          }
        }
      ]
    },
    {
      "name": "7. Chat & Messaging",
      "item": [
        {
          "name": "Get All Conversations (Inbox)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "messages"]
            }
          }
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiverId\": \"{{targetUserId}}\",\n  \"content\": \"Hey! Loved your profile ✨\",\n  \"messageType\": \"text\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "messages"]
            }
          }
        },
        {
          "name": "Get Conversation Thread",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages/{{targetUserId}}?page=1&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "messages", "{{targetUserId}}"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Message",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages/delete/{{messageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "messages", "delete", "{{messageId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "8. Account Lifecycle",
      "item": [
        {
          "name": "Deactivate Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/account/deactivate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "account", "deactivate"]
            }
          }
        },
        {
          "name": "Request Account Deletion OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.devOtp) {",
                  "  pm.collectionVariables.set('deletionOtp', jsonData.data.devOtp);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/account/deletion-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "account", "deletion-otp"]
            }
          }
        },
        {
          "name": "Confirm Account Deletion (Destructive)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"{{deletionOtp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/account/delete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "account", "delete"]
            }
          }
        }
      ]
    }
  ]
}
